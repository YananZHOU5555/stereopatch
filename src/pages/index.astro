---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import MethodStory from "../components/MethodStory.astro";
import TaskAtlas from "../components/TaskAtlas.astro";
import EvidenceSections from "../components/EvidenceSections.astro";
import Closing from "../components/Closing.astro";

const title = "StereoPatch — Policy-Facing Spatial Perception";
const description =
  "StereoPatch retrieves registered metric geometry into RGB patch addresses before action decoding for spatially demanding robot manipulation.";
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="content">
    <article>
      <Hero />
      <MethodStory />
      <TaskAtlas />
      <EvidenceSections />
      <Closing />
    </article>
  </main>

  <script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    document.documentElement.classList.add("motion-ready");

    const revealTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
    const revealNow = (target: HTMLElement) => target.classList.add("is-revealed");
    if (reduceMotion.matches || !("IntersectionObserver" in window)) {
      revealTargets.forEach(revealNow);
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          revealNow(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      }, { rootMargin: "0px 0px -8%", threshold: 0.12 });
      revealTargets.forEach((target) => revealObserver.observe(target));
    }

    document.querySelectorAll<HTMLElement>("[data-evidence-matrix]").forEach((matrix) => {
      const cells = Array.from(matrix.querySelectorAll<HTMLElement>("[data-col]"));
      const clearColumn = () => cells.forEach((cell) => cell.classList.remove("is-active-column"));
      const setColumn = (column: string | undefined) => {
        clearColumn();
        if (column === undefined) return;
        cells.filter((cell) => cell.dataset.col === column).forEach((cell) => cell.classList.add("is-active-column"));
      };
      matrix.querySelectorAll<HTMLElement>("[data-matrix-cell]").forEach((cell) => {
        cell.addEventListener("mouseenter", () => setColumn(cell.dataset.col));
      });
      matrix.querySelectorAll<HTMLElement>("[data-matrix-task]").forEach((task) => {
        task.addEventListener("mouseenter", () => setColumn(task.dataset.col));
        task.addEventListener("focus", () => setColumn(task.dataset.col));
      });
      matrix.addEventListener("mouseleave", clearColumn);
      matrix.addEventListener("focusout", (event) => {
        if (!matrix.contains(event.relatedTarget as Node | null)) clearColumn();
      });
    });

    const simulationVideos = Array.from(document.querySelectorAll<HTMLVideoElement>("video[data-simulation-video]"));
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const pauseSimulationVideos = (except?: HTMLVideoElement) => {
      simulationVideos.forEach((video) => {
        if (video === except) return;
        video.pause();
        video.closest(".simulation-tile")?.classList.remove("is-playing");
      });
    };
    const loadSimulationVideo = (video: HTMLVideoElement) => {
      if (video.src || !video.dataset.src) return;
      video.src = video.dataset.src;
      video.load();
    };
    const playSimulationVideo = async (video: HTMLVideoElement, userInitiated = false) => {
      if ((!userInitiated && reduceMotion.matches) || document.hidden) return;
      loadSimulationVideo(video);
      pauseSimulationVideos(video);
      try {
        await video.play();
        video.closest(".simulation-tile")?.classList.add("is-playing");
      } catch {
        video.closest(".simulation-tile")?.classList.remove("is-playing");
      }
    };
    simulationVideos.forEach((video) => {
      const tile = video.closest<HTMLElement>(".simulation-tile");
      if (!tile) return;
      tile.addEventListener("mouseenter", () => {
        if (finePointer.matches) playSimulationVideo(video);
      });
      tile.addEventListener("mouseleave", () => {
        if (!finePointer.matches) return;
        video.pause();
        tile.classList.remove("is-playing");
      });
      tile.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        if (video.paused) playSimulationVideo(video, true);
        else {
          video.pause();
          tile.classList.remove("is-playing");
        }
      });
      tile.addEventListener("focusout", (event) => {
        if (tile.contains(event.relatedTarget as Node | null)) return;
        video.pause();
        tile.classList.remove("is-playing");
      });
      video.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (video.paused) playSimulationVideo(video, true);
        else {
          video.pause();
          tile.classList.remove("is-playing");
        }
      });
      video.addEventListener("ended", () => tile.classList.remove("is-playing"));
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pauseSimulationVideos();
    });

    class EvidenceMediaController {
      videos = Array.from(document.querySelectorAll<HTMLVideoElement>("video[data-evidence-video]"));
      active: HTMLVideoElement | null = null;
      observer: IntersectionObserver;

      constructor() {
        this.observer = new IntersectionObserver((entries) => this.onIntersect(entries), {
          rootMargin: "0px",
          threshold: [0, 0.05, 0.35, 0.65],
        });
        this.videos.forEach((video) => {
          this.observer.observe(video);
          video.closest(".media-frame")?.querySelector("[data-media-toggle]")?.addEventListener("click", () => this.toggle(video));
          video.addEventListener("click", () => this.toggle(video));
          video.closest(".media-frame")?.addEventListener("mouseenter", () => {
            delete video.dataset.userPaused;
            this.play(video);
          });
          video.closest(".media-frame")?.addEventListener("focusin", () => {
            delete video.dataset.userPaused;
            this.play(video);
          });
          video.addEventListener("play", () => this.syncButton(video, true));
          video.addEventListener("pause", () => this.syncButton(video, false));
        });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) this.pauseAll();
          else this.selectBest();
        });
        reduceMotion.addEventListener("change", () => this.selectBest());
      }

      load(video: HTMLVideoElement) {
        if (video.src || !video.dataset.src) return;
        video.src = video.dataset.src;
        video.load();
      }

      async play(video: HTMLVideoElement, userInitiated = false) {
        if ((!userInitiated && reduceMotion.matches) || document.hidden) return;
        delete video.dataset.userPaused;
        this.load(video);
        this.videos.forEach((other) => { if (other !== video) other.pause(); });
        this.active = video;
        try { await video.play(); } catch { this.syncButton(video, false); }
      }

      toggle(video: HTMLVideoElement) {
        if (!video.paused) {
          video.dataset.userPaused = "true";
          video.pause();
        }
        else this.play(video, true);
      }

      pauseAll() {
        this.videos.forEach((video) => video.pause());
        this.active = null;
      }

      syncButton(video: HTMLVideoElement, playing: boolean) {
        const button = video.closest(".media-frame")?.querySelector("[data-media-toggle]");
        if (!button) return;
        button.setAttribute("aria-label", `${playing ? "Pause" : "Play"} video`);
        const icon = button.querySelector("span");
        if (icon) icon.textContent = playing ? "Ⅱ" : "▶";
        video.closest(".media-frame")?.classList.toggle("is-playing", playing);
      }

      onIntersect(entries: IntersectionObserverEntry[]) {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          video.dataset.visibleRatio = String(entry.intersectionRatio);
          if (!reduceMotion.matches && entry.isIntersecting && entry.intersectionRatio > 0.05) this.load(video);
          if (!entry.isIntersecting || entry.intersectionRatio <= 0.05) {
            video.pause();
            if (this.active === video) this.active = null;
          }
        });
        this.selectBest();
      }

      selectBest() {
        if (reduceMotion.matches || document.hidden) return this.pauseAll();
        const candidates = this.videos
          .map((video) => ({ video, ratio: Number(video.dataset.visibleRatio || 0), priority: video.dataset.priority === "hero" ? 0.08 : 0 }))
          .filter((item) => item.ratio > 0.42 && item.video.dataset.userPaused !== "true")
          .sort((a, b) => (b.ratio + b.priority) - (a.ratio + a.priority));
        if (candidates[0] && (candidates[0].video !== this.active || candidates[0].video.paused)) this.play(candidates[0].video);
      }
    }

    new EvidenceMediaController();

    document.querySelectorAll<HTMLElement>("[data-method-inspector]").forEach((inspector) => {
      const tabs = Array.from(inspector.querySelectorAll<HTMLButtonElement>("[data-method-tab]"));
      const panels = Array.from(inspector.querySelectorAll<HTMLElement>("[data-method-panel]"));
      const focusLayers = Array.from(inspector.querySelectorAll<SVGGElement>("[data-method-focus]"));
      const hotspots = Array.from(inspector.querySelectorAll<HTMLButtonElement>("[data-method-hotspot]"));
      const stage = inspector.querySelector<HTMLElement>("[data-method-stage]");
      const scroller = inspector.querySelector<HTMLElement>(".method-figure-scroll");
      const tabStrip = inspector.querySelector<HTMLElement>(".method-tabs");

      const centerStage = (
        tab: HTMLButtonElement,
        behavior: ScrollBehavior = reduceMotion.matches ? "auto" : "smooth",
      ) => {
        if (!stage || !scroller || scroller.scrollWidth <= scroller.clientWidth + 2) return;
        const center = Number(tab.dataset.methodCenter || 0);
        const target = (center / 3874) * stage.offsetWidth - scroller.clientWidth / 2;
        const left = Math.max(0, Math.min(scroller.scrollWidth - scroller.clientWidth, target));
        scroller.scrollTo({ left, behavior });
      };

      const centerTab = (
        tab: HTMLButtonElement,
        behavior: ScrollBehavior = reduceMotion.matches ? "auto" : "smooth",
      ) => {
        if (!tabStrip || tabStrip.scrollWidth <= tabStrip.clientWidth + 2) return;
        const stripRect = tabStrip.getBoundingClientRect();
        const tabRect = tab.getBoundingClientRect();
        const target = tabStrip.scrollLeft + tabRect.left - stripRect.left + tabRect.width / 2 - stripRect.width / 2;
        const left = Math.max(0, Math.min(tabStrip.scrollWidth - tabStrip.clientWidth, target));
        tabStrip.scrollTo({ left, behavior });
      };

      const activate = (tab: HTMLButtonElement, shouldCenter = true) => {
        const id = tab.dataset.methodTab;
        if (!id) return;
        tabs.forEach((candidate) => {
          const active = candidate === tab;
          candidate.classList.toggle("is-active", active);
          candidate.setAttribute("aria-selected", String(active));
          candidate.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.methodPanel !== id; });
        focusLayers.forEach((layer) => layer.classList.toggle("is-active", layer.dataset.methodFocus === id));
        hotspots.forEach((hotspot) => {
          const active = hotspot.dataset.methodHotspot === id;
          hotspot.classList.toggle("is-active", active);
          hotspot.setAttribute("aria-pressed", String(active));
        });
        if (stage) stage.dataset.activeMethod = id;
        if (shouldCenter) centerStage(tab);
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = index;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          const next = tabs[nextIndex];
          next.focus();
          activate(next);
        });
      });

      hotspots.forEach((hotspot) => {
        const activateHotspot = () => {
          const tab = tabs.find((candidate) => candidate.dataset.methodTab === hotspot.dataset.methodHotspot);
          if (tab) {
            activate(tab, false);
            centerTab(tab);
          }
        };
        hotspot.addEventListener("click", activateHotspot);
        hotspot.addEventListener("focus", activateHotspot);
      });

      const initial = tabs.find((tab) => tab.getAttribute("aria-selected") === "true");
      if (initial && window.matchMedia("(max-width: 820px)").matches) {
        window.requestAnimationFrame(() => {
          centerStage(initial, "auto");
          centerTab(initial, "auto");
        });
      }
    });

    document.querySelectorAll<HTMLElement>(".comparison-panels").forEach((panels) => {
      const rows = Array.from(panels.querySelectorAll<HTMLElement>("[data-method-family]"));
      const clearLinkedRows = () => {
        panels.classList.remove("has-linked-row");
        rows.forEach((row) => row.classList.remove("is-linked-row"));
      };
      rows.forEach((row) => row.addEventListener("mouseenter", () => {
        clearLinkedRows();
        panels.classList.add("has-linked-row");
        rows.filter((candidate) => candidate.dataset.methodFamily === row.dataset.methodFamily)
          .forEach((candidate) => candidate.classList.add("is-linked-row"));
      }));
      panels.addEventListener("mouseleave", clearLinkedRows);
    });

    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-bib]");
    if (copyButton) {
      copyButton.addEventListener("click", async () => {
        const code = document.querySelector("#bibtex code")?.textContent || "";
        await navigator.clipboard.writeText(code);
        copyButton.textContent = "Copied";
        window.setTimeout(() => { copyButton.textContent = "Copy BibTeX"; }, 1600);
      });
    }
  </script>
</BaseLayout>
